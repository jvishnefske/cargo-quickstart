[package]
name = "[[ crate_name ]]"
version = "0.1.0"
edition = "[[ edition ]]"
description = "[[ description ]]"
authors = ["[[ author_name ]] <[[ author_email ]]>"]
[%- if has_license %]
license = "[[ license ]]"
[%- endif %]

# `staticlib` is what the iOS app links; `lib` keeps `cargo test` working.
[lib]
crate-type = ["staticlib", "lib"]

[lints.clippy]
all = { level = "warn", priority = -1 }

[profile.release]
opt-level = "z"
lto = true
strip = true
