[package]
name = "[[ crate_name ]]"
version = "0.1.0"
edition = "[[ edition ]]"
description = "[[ description ]]"
authors = ["[[ author_name ]] <[[ author_email ]]>"]
[%- if has_license %]
license = "[[ license ]]"
[%- endif %]

[dependencies]
wasm-bindgen = "0.2"
console_error_panic_hook = "0.1"

[dependencies.web-sys]
version = "0.3"
features = ["Document", "Element", "HtmlElement", "Window"]

[lints.clippy]
all = { level = "warn", priority = -1 }

[profile.release]
opt-level = "z"
lto = true
