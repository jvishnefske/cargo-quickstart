//! [[ description ]]
//!
//! A 12-factor microservice built on a transport-agnostic message layer: the
//! HTTP handlers, the background workers, and the domain logic all speak the
//! [`Transport`] trait, so the same binary runs over an in-process bus or a NATS
//! broker (feature `transport-nats`) with no code changes. See ARCHITECTURE.md.
//!
//! It exercises all three interaction patterns:
//! - command/reply: `POST /items` sends an `items.create` command, acked with the row.
//! - publish/subscribe: the command handler emits an `items.events` event.
//! - request/response: `GET /items/count` queries `items.count`.

mod config;
mod model;
mod transport;

use axum::extract::Request;
use axum::middleware::{self, Next};
use axum::response::Response;
use axum::{Json, Router, extract::State, http::StatusCode, response::IntoResponse, routing::get};
use bytes::Bytes;
use futures::StreamExt;
use sea_orm::DatabaseConnection;
use serde::{Deserialize, Serialize};
use std::sync::Arc;
use tokio::sync::Semaphore;

use config::Config;
use transport::memory::MemoryTransport;
use transport::{MessageEnvelope, TracedTransport, Transport};

/// Command: create an item (acknowledged write).
const ITEMS_CREATE: &str = "items.create";
/// Event: "an item was created" (fire-and-forget, one-to-many).
const ITEMS_EVENTS: &str = "items.events";
/// Query: "how many items?" (request/response).
const ITEMS_COUNT: &str = "items.count";

#[derive(Clone)]
struct AppState {
    db: DatabaseConnection,
    transport: Arc<dyn Transport>,
}

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    // Factor XI: logs are an event stream on stdout; RUST_LOG controls the level.
    tracing_subscriber::fmt()
        .with_env_filter(
            tracing_subscriber::EnvFilter::try_from_default_env().unwrap_or_else(|_| "info".into()),
        )
        .init();

    let cfg = Config::from_env()?;
    tracing::info!(app = %cfg.app_name, addr = %cfg.bind_addr, "starting");

    let db = model::connect(&cfg.database_url).await?;
    let transport = build_transport(&cfg).await?;

    spawn_workers(&db, &transport).await?;

    let state = AppState {
        db,
        transport: transport.clone(),
    };
    // Factor VIII / backpressure: cap concurrent in-flight requests and shed load
    // (503) past the limit, so the service never accepts work it can't process.
    let inflight = Arc::new(Semaphore::new(cfg.max_inflight));
    let app = Router::new()
        .route("/healthz", get(|| async { "ok" }))
        .route("/readyz", get(readyz))
        .route("/items", get(list_items).post(create_item))
        .route("/items/count", get(count_items))
        .with_state(state)
        .layer(middleware::from_fn_with_state(
            inflight,
            shed_when_overloaded,
        ));

    let listener = tokio::net::TcpListener::bind(cfg.bind_addr).await?;
    tracing::info!("listening on http://{}", listener.local_addr()?);
    axum::serve(listener, app)
        .with_graceful_shutdown(shutdown_signal())
        .await?;
    Ok(())
}

/// Background workers, all expressed purely against the [`Transport`] trait.
async fn spawn_workers(
    db: &DatabaseConnection,
    transport: &Arc<dyn Transport>,
) -> anyhow::Result<()> {
    // Command/reply: insert an item (acknowledged write) and emit an event.
    {
        let db = db.clone();
        let transport = transport.clone();
        let mut commands = transport
            .subscribe(ITEMS_CREATE)
            .await
            .map_err(|e| anyhow::anyhow!("subscribe {ITEMS_CREATE}: {e}"))?;
        tokio::spawn(async move {
            while let Some(cmd) = commands.next().await {
                let name = String::from_utf8_lossy(&cmd.payload).into_owned();
                match model::insert_item(&db, name).await {
                    Ok(item) => {
                        let body = Bytes::from(serde_json::to_vec(&item).unwrap_or_default());
                        // Notify subscribers (decoupled), then ACK the command.
                        let _ = transport
                            .publish(MessageEnvelope::event(ITEMS_EVENTS, body.clone()))
                            .await;
                        if let Some(reply) = cmd.reply(body) {
                            let _ = transport.publish(reply).await;
                        }
                    }
                    Err(e) => {
                        tracing::error!("command {ITEMS_CREATE} failed: {e}");
                        // NACK: empty reply. A production system would route to a
                        // dead-letter queue and return a typed error envelope.
                        if let Some(reply) = cmd.reply(Bytes::new()) {
                            let _ = transport.publish(reply).await;
                        }
                    }
                }
            }
        });
    }

    // Publish/subscribe: react to item.created events.
    {
        let mut events = transport
            .subscribe(ITEMS_EVENTS)
            .await
            .map_err(|e| anyhow::anyhow!("subscribe {ITEMS_EVENTS}: {e}"))?;
        tokio::spawn(async move {
            while let Some(ev) = events.next().await {
                tracing::info!(id = %ev.message_id, "event handled");
            }
        });
    }

    // Request/response: answer item-count queries from the database.
    {
        let db = db.clone();
        let transport = transport.clone();
        let mut queries = transport
            .subscribe(ITEMS_COUNT)
            .await
            .map_err(|e| anyhow::anyhow!("subscribe {ITEMS_COUNT}: {e}"))?;
        tokio::spawn(async move {
            while let Some(req) = queries.next().await {
                let count = model::count_items(&db).await.unwrap_or(0);
                if let Some(reply) = req.reply(Bytes::from(count.to_string())) {
                    let _ = transport.publish(reply).await;
                }
            }
        });
    }

    Ok(())
}

/// Pick the transport from configuration. The in-memory bus is the default; the
/// NATS broker is used when built with `--features transport-nats` and a
/// `NATS_URL` is set. Either way the rest of the program is identical.
async fn build_transport(cfg: &Config) -> anyhow::Result<Arc<dyn Transport>> {
    #[cfg(feature = "transport-nats")]
    if let Some(url) = std::env::var("NATS_URL").ok().filter(|s| !s.is_empty()) {
        tracing::info!(%url, "using NATS transport");
        let nats = transport::nats::NatsTransport::connect(&url, cfg.app_name.clone())
            .await
            .map_err(|e| anyhow::anyhow!("connecting to NATS: {e}"))?;
        return Ok(Arc::new(TracedTransport::new(nats)));
    }

    tracing::info!("using in-process transport");
    let memory = MemoryTransport::new(cfg.bus_buffer).with_timeout(cfg.request_timeout);
    Ok(Arc::new(TracedTransport::new(memory)))
}

/// Factor IX (disposability): shut down cleanly on Ctrl-C or SIGTERM — the signal
/// Kubernetes sends before terminating a pod.
async fn shutdown_signal() {
    let ctrl_c = async {
        let _ = tokio::signal::ctrl_c().await;
    };
    #[cfg(unix)]
    let terminate = async {
        if let Ok(mut sig) =
            tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
        {
            sig.recv().await;
        }
    };
    #[cfg(not(unix))]
    let terminate = std::future::pending::<()>();

    tokio::select! {
        _ = ctrl_c => {},
        _ = terminate => {},
    }
    tracing::info!("shutdown signal received");
}

/// Ingress backpressure: hold a permit for each request's lifetime; if none is
/// free the service is at capacity, so shed the load with 503 rather than
/// queueing work it cannot process. A Tower `load_shed` + `concurrency_limit`
/// stack expresses the same readiness gate via `poll_ready`.
async fn shed_when_overloaded(
    State(limit): State<Arc<Semaphore>>,
    request: Request,
    next: Next,
) -> Response {
    match Arc::clone(&limit).try_acquire_owned() {
        Ok(_permit) => next.run(request).await,
        Err(_) => (StatusCode::SERVICE_UNAVAILABLE, "overloaded").into_response(),
    }
}

/// Readiness probe: healthy only when the database answers.
async fn readyz(State(state): State<AppState>) -> impl IntoResponse {
    match state.db.ping().await {
        Ok(()) => (StatusCode::OK, "ready"),
        Err(_) => (StatusCode::SERVICE_UNAVAILABLE, "not ready"),
    }
}

#[derive(Deserialize)]
struct CreateItem {
    name: String,
}

/// Command/reply: turn the HTTP request into an `items.create` command and return
/// the acknowledged result.
async fn create_item(
    State(state): State<AppState>,
    Json(body): Json<CreateItem>,
) -> impl IntoResponse {
    let command = MessageEnvelope::command(ITEMS_CREATE, Bytes::from(body.name));
    match state.transport.request(command).await {
        Ok(reply) if !reply.payload.is_empty() => {
            match serde_json::from_slice::<serde_json::Value>(&reply.payload) {
                Ok(item) => (StatusCode::CREATED, Json(item)).into_response(),
                Err(_) => (StatusCode::INTERNAL_SERVER_ERROR, "malformed reply").into_response(),
            }
        }
        Ok(_) => (StatusCode::INTERNAL_SERVER_ERROR, "command rejected").into_response(),
        Err(e) => {
            tracing::error!("create command failed: {e}");
            (StatusCode::INTERNAL_SERVER_ERROR, "bus error").into_response()
        }
    }
}

/// Reads are answered in-handler; only writes go through the command bus.
async fn list_items(State(state): State<AppState>) -> impl IntoResponse {
    match model::list_items(&state.db).await {
        Ok(items) => (StatusCode::OK, Json(items)).into_response(),
        Err(e) => {
            tracing::error!("list failed: {e}");
            (StatusCode::INTERNAL_SERVER_ERROR, "database error").into_response()
        }
    }
}

#[derive(Serialize)]
struct Count {
    count: i64,
}

/// Request/response over the transport: ask the responder task for the count.
async fn count_items(State(state): State<AppState>) -> impl IntoResponse {
    let query = MessageEnvelope::query(ITEMS_COUNT, Bytes::new());
    match state.transport.request(query).await {
        Ok(reply) => {
            let count = std::str::from_utf8(&reply.payload)
                .ok()
                .and_then(|s| s.parse::<i64>().ok())
                .unwrap_or(0);
            (StatusCode::OK, Json(Count { count })).into_response()
        }
        Err(e) => {
            tracing::error!("count request failed: {e}");
            (StatusCode::INTERNAL_SERVER_ERROR, "bus error").into_response()
        }
    }
}
