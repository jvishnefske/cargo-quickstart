//! Transport-agnostic message bus built on `futures::Stream` (receive) and
//! `futures::Sink` (send).
//!
//! The default transport is an in-process channel, but anything implementing
//! `Stream`/`Sink` — a NATS subject, a Kafka topic, a Redis stream — drops in
//! without changing a single call site: the rest of the app only ever sees a
//! `Sink<Event>` to publish to and a `Stream<Item = Event>` to consume.
//!
//! `Traced` is the bus middleware: a small combinator that wraps an inner
//! stream or sink and instruments every message with `tracing`. Compose it with
//! the usual `StreamExt`/`SinkExt` combinators (`filter`, `map`, `for_each`, …).

use std::pin::Pin;
use std::task::{Context, Poll};

use futures::{Sink, Stream};
use pin_project_lite::pin_project;
use serde::{Deserialize, Serialize};

/// A domain event published on the bus.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Event {
    pub id: String,
    pub kind: String,
    pub name: String,
}

/// Create an in-process pub/sub channel. The `Sender` is a `Sink<Event>` and the
/// `Receiver` is a `Stream<Item = Event>` — the two halves of the bus.
pub fn channel(
    buffer: usize,
) -> (
    futures::channel::mpsc::Sender<Event>,
    futures::channel::mpsc::Receiver<Event>,
) {
    futures::channel::mpsc::channel(buffer)
}

pin_project! {
    /// Middleware that logs every item flowing through an inner `Stream` or `Sink`.
    pub struct Traced<S> {
        #[pin]
        inner: S,
        label: &'static str,
    }
}

impl<S> Traced<S> {
    pub fn new(inner: S, label: &'static str) -> Self {
        Self { inner, label }
    }
}

impl<S> Stream for Traced<S>
where
    S: Stream,
    S::Item: std::fmt::Debug,
{
    type Item = S::Item;

    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
        let this = self.project();
        let polled = this.inner.poll_next(cx);
        if let Poll::Ready(Some(item)) = &polled {
            tracing::debug!(bus = this.label, ?item, "received");
        }
        polled
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        self.inner.size_hint()
    }
}

impl<S, Item> Sink<Item> for Traced<S>
where
    S: Sink<Item>,
    Item: std::fmt::Debug,
{
    type Error = S::Error;

    fn poll_ready(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
        self.project().inner.poll_ready(cx)
    }

    fn start_send(self: Pin<&mut Self>, item: Item) -> Result<(), Self::Error> {
        let this = self.project();
        tracing::debug!(bus = this.label, ?item, "sent");
        this.inner.start_send(item)
    }

    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
        self.project().inner.poll_flush(cx)
    }

    fn poll_close(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
        self.project().inner.poll_close(cx)
    }
}
