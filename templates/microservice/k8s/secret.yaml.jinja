# Demo secret. In a real cluster, generate this from a secret manager (Sealed
# Secrets, External Secrets, SOPS) — do not commit real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: [[ project_name ]]-secrets
type: Opaque
stringData:
  # The pod runs with readOnlyRootFilesystem, so use a networked database here
  # (managed Postgres/MySQL), not a file-backed sqlite URL.
  DATABASE_URL: "postgres://user:password@postgres:5432/[[ crate_name ]]"
