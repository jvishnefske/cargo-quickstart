apiVersion: apps/v1
kind: Deployment
metadata:
  name: [[ project_name ]]
  labels:
    app: [[ project_name ]]
spec:
  replicas: 2
  selector:
    matchLabels:
      app: [[ project_name ]]
  template:
    metadata:
      labels:
        app: [[ project_name ]]
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          image: [[ project_name ]]:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
          # Config and secrets are attached resources, not baked into the image.
          envFrom:
            - configMapRef:
                name: [[ project_name ]]-config
            - secretRef:
                name: [[ project_name ]]-secrets
          readinessProbe:
            httpGet:
              path: /readyz
              port: 8080
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 15
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
      # Factor IX: give the process time to drain on SIGTERM.
      terminationGracePeriodSeconds: 30
