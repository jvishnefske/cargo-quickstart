# 12-factor configuration (factor III). Copy to `.env` for local development.
# In production these are injected by the platform (e.g. a Kubernetes ConfigMap
# and Secret) — never shipped as a file in the image.

APP_NAME=[[ crate_name ]]
HOST=0.0.0.0
PORT=8080

# Attached backing service (factor IV). SeaORM picks the driver from the scheme:
#   sqlite://data.db?mode=rwc
#   postgres://user:password@localhost:5432/[[ crate_name ]]
#   mysql://user:password@localhost:3306/[[ crate_name ]]
DATABASE_URL=sqlite://data.db?mode=rwc

# In-process message bus channel capacity.
BUS_BUFFER=128

# Hard timeout (seconds) on request/response + command/reply round-trips. Bounds
# the correlation registry so abandoned requests cannot leak memory.
REQUEST_TIMEOUT_SECS=5

# Max concurrent in-flight HTTP requests; past this the service sheds load (503).
MAX_INFLIGHT=1024

# Broker transport (only used when built with --features transport-nats). When
# set, the service connects to NATS instead of using the in-process bus.
# NATS_URL=nats://localhost:4222

# Log filter (factor XI: logs are an event stream on stdout).
RUST_LOG=info,[[ crate_name ]]=debug

# Distributed tracing. Build with `--features otel` to export OpenTelemetry spans
# and propagate W3C trace context through the message-envelope metadata. Spans
# print to stdout by default; in production run a collector and swap the stdout
# exporter for opentelemetry-otlp (see src/telemetry.rs), pointing it here:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
