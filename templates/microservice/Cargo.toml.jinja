[package]
name = "[[ crate_name ]]"
version = "0.1.0"
edition = "[[ edition ]]"
description = "[[ description ]]"
authors = ["[[ author_name ]] <[[ author_email ]]>"]
[%- if has_license %]
license = "[[ license ]]"
[%- endif %]

[features]
# Database backends. SeaORM selects one at runtime from DATABASE_URL's scheme;
# these gate which drivers are compiled in.
default = ["backend-postgres", "backend-sqlite"]
backend-postgres = ["sea-orm/sqlx-postgres"]
backend-mysql = ["sea-orm/sqlx-mysql"]
backend-sqlite = ["sea-orm/sqlx-sqlite"]
# Out-of-process broker transport. Off by default so the service builds and runs
# on the in-memory transport with no external dependencies.
transport-nats = ["dep:async-nats"]

[dependencies]
axum = "0.7"
tokio = { version = "1", features = [
    "macros",
    "rt-multi-thread",
    "signal",
    "sync",
    "time",
] }
tokio-stream = { version = "0.1", features = ["sync"] }
futures = "0.3"
async-trait = "0.1"
bytes = { version = "1", features = ["serde"] }
sea-orm = { version = "1", default-features = false, features = [
    "runtime-tokio-rustls",
    "macros",
] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
anyhow = "1"
uuid = { version = "1", features = ["v4"] }
async-nats = { version = "0.38", optional = true }

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
all = { level = "warn", priority = -1 }
