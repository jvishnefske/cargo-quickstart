//! [[ description ]]

/// Adds two numbers together.
///
/// # Examples
///
/// ```
/// assert_eq!([[ crate_name ]]::add(2, 2), 4);
/// ```
#[must_use]
pub fn add(left: i64, right: i64) -> i64 {
    left + right
}

